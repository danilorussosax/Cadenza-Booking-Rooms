npx lint-staged

# Gitleaks: scan dei file staged per chiavi/token committate per sbaglio.
# Eseguito SOLO se gitleaks è installato localmente (`brew install gitleaks`
# o equivalente). Se manca, skip silenzioso — il check resta enforced in CI
# tramite `gitleaks/gitleaks-action` su ogni push/PR.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --config .gitleaks.toml || {
    echo ""
    echo "❌ gitleaks ha rilevato secret in staging."
    echo "   Rimuovi il leak (NON commit poi rimozione: la history conterrebbe ancora il secret)."
    echo "   Per allowlist legittime: aggiungi pattern in .gitleaks.toml"
    echo ""
    exit 1
  }
fi
