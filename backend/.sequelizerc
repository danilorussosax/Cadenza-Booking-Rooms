'use strict';

const path = require('path');

// Configurazione paths sequelize-cli — mantenuta separata dai paths default
// per non collidere con i file custom esistenti:
//   - models/index.js  → custom (associations, hooks)
//   - seeders/initial.js  → seeder custom (idempotente, gira a startup)
// Le migration introdotte da sequelize-cli vivono in migrations/, separate
// dal sistema preSyncMigrations.js che resta come compat layer (vedi
// docs/MIGRATIONS.md).
module.exports = {
  config: path.resolve(__dirname, 'config', 'sequelize-cli.js'),
  'migrations-path': path.resolve(__dirname, 'migrations'),
  'seeders-path': path.resolve(__dirname, 'seeders-cli'),
  'models-path': path.resolve(__dirname, 'models'),
};
