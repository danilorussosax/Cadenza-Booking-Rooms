# ===================================
# Server
# ===================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ===================================
# Database
# Supportato: sqlite | postgres | mysql | mariadb
# ===================================
DB_DIALECT=sqlite
DB_STORAGE=./data/conservatory.sqlite

# Per PostgreSQL/MySQL/MariaDB scommentare e compilare:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=conservatory
# DB_USER=conservatory_user
# DB_PASSWORD=changeme
# DB_SSL=true                        # solo postgres, abilita TLS
# DB_SSL_REJECT_UNAUTHORIZED=true
#
# === PgBouncer (connection pooling) ===
# Per attivare: imposta DB_PORT=6432 e opzionalmente DB_PGBOUNCER=true.
# Il pool Sequelize rimane attivo ma il multiplexing reale verso Postgres
# lo fa PgBouncer in transaction pooling mode (vedi scripts/setup-pgbouncer.sh).
#   DB_PORT=6432                     # PgBouncer ascolta su questa porta
#   DB_PGBOUNCER=true                # flag esplicito (opzionale, auto-rilevato se DB_PORT=6432)
# Con PgBouncer attivo:
#   - prepared_statements viene disattivato automaticamente (necessario per
#     transaction pooling, dove ogni tx può cambiare connessione server)
#   - DB_POOL_MAX va tenuto a 20 (lato app) — il limite reale è il
#     default_pool_size di PgBouncer (~25)
#   - FOR UPDATE SKIP LOCKED (mailOutboxScheduler) è compatibile
#   - SERIALIZABLE isolation (serializableTx.js) è compatibile

# Strategia sincronizzazione schema (default: safe)
#   safe   - crea solo tabelle/indici mancanti, NON altera niente
#   alter  - adegua lo schema (usa "npm run db:migrate" dopo modifiche ai model)
#   force  - DROP + CREATE di tutto (PERDE I DATI, usa con cautela)
#   none   - non chiama sync (per migrazioni gestite esternamente)
DB_SYNC_MODE=safe

# Connessione (retry esponenziale all'avvio)
DB_CONNECT_ATTEMPTS=5
DB_CONNECT_BASE_DELAY=800

# Pool di connessioni (rilevante per Postgres/MySQL)
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Logging SQL: true | false | (vuoto = auto: off in prod, riassunto in dev)
# DB_LOGGING=

# Esecuzione del seeder allo startup (true | false)
DB_SEED=true

# ===================================
# Sicurezza (CAMBIARE IN PRODUZIONE!)
# ===================================
JWT_SECRET=cambiami-con-una-stringa-casuale-molto-lunga-e-sicura
# Durata JWT — default 2h (allineato a middleware/auth.js DEFAULT_JWT_EXPIRES_IN).
# In assenza di refresh token, una scadenza più lunga (es. 7d) è un trade-off:
# UX migliore ma finestra di compromise più ampia se il device è rubato.
# `tokenVersion` mitiga (l'utente fa logout → bumpa versione → tutti i JWT
# vecchi rifiutati), ma il drift resta. Per single-page app interattive 2h
# è il giusto compromesso. Da elevare a 4h-12h solo se richiesto dal flusso
# di lavoro (es. kiosk display sempre acceso 8h/giorno).
JWT_EXPIRES_IN=2h

# ===================================
# OAuth Google
# Crea credenziali su https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# ===================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ===================================
# OAuth Microsoft
# Crea app su https://portal.azure.com -> Azure AD -> App registrations
# Redirect URI: http://localhost:3000/api/auth/microsoft/callback
# ===================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# ===================================
# Admin di default (creato al primo avvio se non presente)
# ===================================
DEFAULT_ADMIN_EMAIL=admin@conservatorio.it
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_FIRSTNAME=Amministratore
DEFAULT_ADMIN_LASTNAME=Sistema

# ===================================
# Sentry — error reporting (opzionale, attivo solo in produzione)
# Senza SENTRY_DSN il modulo è no-op (consigliato in dev locale).
# ===================================
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# SENTRY_RELEASE=cadenza@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1            # quota di transazioni (0–1)
# SENTRY_USER_ID_SALT=cambiami-segreto-stabile-per-ambiente
# Smoke test (admin Bearer): POST /api/admin/_sentry/test → { eventId }

# ===================================
# Export Excel periodico (business continuity)
# Il backend scrive un .xlsx su disco ogni N min; sincronizza la cartella
# verso OneDrive/Dropbox con rclone (vedi docs/EXCEL_SYNC.md).
# ===================================
EXCEL_EXPORT_ENABLED=false
EXCEL_EXPORT_PATH=/var/cadenza/sync/cadenza-prenotazioni.xlsx
EXCEL_EXPORT_TICK_MIN=10                  # intervallo tra export (1–60 min)
EXCEL_EXPORT_LOOKAHEAD_DAYS=30            # finestra prenotazioni esportate
