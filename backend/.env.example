# ===================================
# Server
# ===================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ===================================
# Database
# Supportato: sqlite | postgres | mysql | mariadb
# ===================================
DB_DIALECT=sqlite
DB_STORAGE=./data/conservatory.sqlite

# Per PostgreSQL/MySQL/MariaDB scommentare e compilare:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=conservatory
# DB_USER=conservatory_user
# DB_PASSWORD=changeme
# DB_SSL=true                        # solo postgres, abilita TLS
# DB_SSL_REJECT_UNAUTHORIZED=true

# Strategia sincronizzazione schema (default: safe)
#   safe   - crea solo tabelle/indici mancanti, NON altera niente
#   alter  - adegua lo schema (usa "npm run db:migrate" dopo modifiche ai model)
#   force  - DROP + CREATE di tutto (PERDE I DATI, usa con cautela)
#   none   - non chiama sync (per migrazioni gestite esternamente)
DB_SYNC_MODE=safe

# Connessione (retry esponenziale all'avvio)
DB_CONNECT_ATTEMPTS=5
DB_CONNECT_BASE_DELAY=800

# Pool di connessioni (rilevante per Postgres/MySQL)
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Logging SQL: true | false | (vuoto = auto: off in prod, riassunto in dev)
# DB_LOGGING=

# Esecuzione del seeder allo startup (true | false)
DB_SEED=true

# ===================================
# Sicurezza (CAMBIARE IN PRODUZIONE!)
# ===================================
JWT_SECRET=cambiami-con-una-stringa-casuale-molto-lunga-e-sicura
JWT_EXPIRES_IN=7d
SESSION_SECRET=altra-stringa-casuale-da-cambiare

# ===================================
# OAuth Google
# Crea credenziali su https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# ===================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ===================================
# OAuth Microsoft
# Crea app su https://portal.azure.com -> Azure AD -> App registrations
# Redirect URI: http://localhost:3000/api/auth/microsoft/callback
# ===================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# ===================================
# Admin di default (creato al primo avvio se non presente)
# ===================================
DEFAULT_ADMIN_EMAIL=admin@conservatorio.it
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_FIRSTNAME=Amministratore
DEFAULT_ADMIN_LASTNAME=Sistema
