# ===================================
# Frontend (Vite) — variabili di build/runtime
# Tutte le variabili devono iniziare con VITE_ per essere esposte al client.
# Senza VITE_SENTRY_DSN il modulo Sentry è no-op (utile in dev locale).
# ===================================

# Sentry — error reporting browser
# VITE_SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# VITE_SENTRY_RELEASE=cadenza@1.0.0
# VITE_SENTRY_USER_ID_SALT=salt-stabile-per-anonimizzare-id-utente

# ===================================
# Sourcemap upload (CI/CD, NON in client) — passate via env in build
# Necessari perché Sentry possa risolvere stack trace minificate.
# ===================================
# SENTRY_AUTH_TOKEN=...           # generato da https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_ORG=cadenza
# SENTRY_PROJECT=cadenza-frontend
# SENTRY_RELEASE=cadenza@1.0.0
