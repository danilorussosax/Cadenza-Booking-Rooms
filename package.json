{
  "name": "cadenza-monorepo",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.14.0",
  "description": "Cadenza — root meta-package per devtools condivisi (husky, lint-staged, commitlint, prettier). Proprietary software, see LICENSE.",
  "author": "Danilo Russo <danilorussosax@gmail.com>",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "bash scripts/dev.sh",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend run start",
    "build": "npm --prefix frontend run build",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\" --ignore-path .gitignore",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test": "npm run test:backend && npm run test:frontend",
    "e2e": "npm --prefix frontend run e2e",
    "e2e:ui": "npm --prefix frontend run e2e:ui",
    "e2e:headed": "npm --prefix frontend run e2e:headed",
    "soak": "bash loadtest/soak.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^17.0.2",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "npm --prefix frontend run lint:fix --"
    ],
    "frontend/**/*.{js,jsx}": [
      "prettier --write"
    ],
    "backend/**/*.js": [
      "prettier --write",
      "npm --prefix backend run lint:fix --"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
